                <div class="s4-url" id="txt-s4-url">www.capracombat.fi/juniorit</div>
              </div>
            </div>
          </div>

          <!-- SLIDE 5: SINGLE 1 (All-in-one) -->
          <div id="slide-5" class="slide-layout">
            <div class="s5-main-text">
              <div class="eyebrow" id="txt-s5-eyebrow">BJJ & LUKKOPAINI</div>
              <div class="s5-headline" id="txt-s5-headline">Uusi junioriryhmä<br><span class="highlight">alkaa 17.9.</span></div>
              <div class="s5-subhead" id="txt-s5-subhead">Ilmoittaudu mukaan: info@capracombat.fi<br>Lisätiedot: www.capracombat.fi/juniorit</div>
            </div>
            
            <div class="s5-info-bar">
              <div class="s5-info-item">
                <span class="s5-info-label" id="txt-s5-l1">AJAT</span>
