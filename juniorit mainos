  <script>
    // Päivitä tekstit (tavallinen)
    function updateText(id) {
      let val = document.getElementById('inp-' + id).value;
      val = val.replace(/\\n|\n/g, '<br>');
      document.getElementById('txt-' + id).innerHTML = val;
    }

    // Päivitä tekstit (korostukset *merkeillä*)
    function updateHeadline(id) {
      let val = document.getElementById('inp-' + id).value;
      val = val.replace(/\\n|\n/g, '<br>');
      val = val.replace(/\*(.*?)\*/g, '<span class="highlight">$1</span>');
      document.getElementById('txt-' + id).innerHTML = val;
    }

    // Teeman vaihto
    function setTheme(themeName) {
      document.getElementById('ig-canvas').className = 'theme-' + themeName;
      document.querySelectorAll('.theme-select button').forEach(btn => btn.classList.remove('active'));
      document.getElementById('btn-theme-' + themeName).classList.add('active');
    }

    // Dian vaihto
    let currentSlide = 1;
    function switchSlide(slideNum) {
      currentSlide = slideNum;
      
      // Update Tabs
      document.querySelectorAll('.tabs button').forEach(btn => btn.classList.remove('active'));
      document.getElementById('tab-' + slideNum).classList.add('active');
      
      // Update Controls
      document.querySelectorAll('.slide-controls').forEach(ctrl => {
        ctrl.classList.remove('active');
      });
      document.getElementById('controls-' + slideNum).classList.add('active');

      // Update Canvas Layouts
      document.querySelectorAll('.slide-layout').forEach(layout => {
        layout.classList.remove('active');
      });
      document.getElementById('slide-' + slideNum).classList.add('active');
    }

    // Taustakuva
    document.getElementById('bg-upload').addEventListener('change', function(e) {
      if(e.target.files && e.target.files[0]) {
        const reader = new FileReader();
        reader.onload = function(event) {
          const img = document.getElementById('bg-img-element');
          img.src = event.target.result;
          img.style.display = 'block';
        }
        reader.readAsDataURL(e.target.files[0]);
      }
    });

    // Valmentajan kuva
    document.getElementById('coach-upload').addEventListener('change', function(e) {
      if(e.target.files && e.target.files[0]) {
        const reader = new FileReader();
        reader.onload = function(event) {
          const img = document.getElementById('coach-img-element');
          img.src = event.target.result;
          img.style.display = 'block';
          document.getElementById('coach-placeholder-icon').style.display = 'none';
        }
        reader.readAsDataURL(e.target.files[0]);
      }
    });

    // Lataa kuva
    function downloadImage() {
      const canvasElement = document.getElementById('ig-canvas');
      const originalTransform = canvasElement.style.transform;
      canvasElement.style.transform = 'scale(1)';

      html2canvas(canvasElement, {
        width: 1080,
        height: 1080,
        scale: 1, 
        useCORS: true,
        backgroundColor: null
      }).then(canvas => {
        canvasElement.style.transform = originalTransform;
        const link = document.createElement('a');
        link.download = `capra_mainos_slide_${currentSlide}.jpg`;
        link.href = canvas.toDataURL('image/jpeg', 0.9);
        link.click();
      });
    }

    // Alusta kaikki tekstit kun sivu ladataan
    const textIds = [
      'kicker', 's1-eyebrow', 's1-subhead', 's2-title', 's2-l1', 's2-v1', 's2-l2', 's2-v2', 's2-l3', 's2-v3', 
      's2-l4', 's2-v4', 's3-title', 's3-name', 's3-role', 's3-quote', 's4-headline', 's4-title', 's4-email', 
      's4-url', 's5-eyebrow', 's5-subhead', 's5-l1', 's5-v1', 's5-l2', 's5-v2', 's5-l3', 's5-v3', 's6-cta'
    ];
    textIds.forEach(updateText);
    
    // Alusta otsikot, joissa on highlight-tuki
    ['s1-headline', 's5-headline', 's6-quote'].forEach(updateHeadline);

  </script>
</body>
</html>
