          <label>Toimintakehote (CTA)</label>
          <textarea id="inp-s6-cta" oninput="updateText('s6-cta')">Uusi junioriryhmä 7-13 vuotiaille.
Ilmoittaudu: info@capracombat.fi
www.capracombat.fi/juniorit</textarea>
        </div>
