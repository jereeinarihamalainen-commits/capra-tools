<!DOCTYPE html>
<html lang="fi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Capra Combat - IG Mainosgeneraattori</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Michroma&display=swap" rel="stylesheet">
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <style>
    :root {
      --capra-olive: #68724A;
      --capra-ochre: #C8AE4D;
      --capra-black: #111111;
      --capra-offwhite: #F3F1EA;
      --capra-white: #FFFFFF;
      --capra-gray: #E0DFDB;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Inter", sans-serif;
      background-color: #2a2a2a;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }

    .app-container {
      display: flex;
      flex-wrap: wrap;
      gap: 40px;
      max-width: 1400px;
      width: 100%;
      justify-content: center;
    }

    /* --- CONTROLS --- */
    .controls {
      background-color: #1e1e1e;
      padding: 25px;
      border-radius: 8px;
      width: 420px;
      max-height: 90vh;
      overflow-y: auto;
    }

    .controls h2 {
      margin-bottom: 15px;
      font-family: "Michroma", sans-serif;
      font-size: 1.1rem;
      color: var(--capra-ochre);
    }

    .tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5px;
      margin-bottom: 20px;
      border-bottom: 1px solid #444;
      padding-bottom: 15px;
    }

    .tabs button {
      padding: 8px 10px;
      background: #333;
      border: 1px solid #444;
      color: white;
      cursor: pointer;
      border-radius: 4px;
      font-weight: bold;
      font-size: 0.75rem;
    }

    .tabs button.active {
      background: var(--capra-olive);
      border-color: var(--capra-olive);
    }

    .theme-select {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    .theme-select button {
      flex: 1;
      padding: 8px;
      background: #444;
      border: none;
      color: white;
      cursor: pointer;
      border-radius: 4px;
    }

    .theme-select button.active {
      background: var(--capra-ochre);
      color: var(--capra-black);
      font-weight: bold;
    }

    .control-group {
      margin-bottom: 15px;
    }

    .control-group label {
      display: block;
      margin-bottom: 5px;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #bbb;
    }

    .control-group input[type="text"],
    .control-group textarea {
      width: 100%;
      padding: 10px;
      background-color: #111;
      border: 1px solid #444;
      color: #fff;
      border-radius: 4px;
      font-family: inherit;
    }

    .control-group input[type="file"] {
      width: 100%;
      padding: 5px 0;
    }

    .control-group textarea {
      resize: vertical;
      min-height: 80px;
    }

    .slide-controls {
      display: none;
    }
    .slide-controls.active {
      display: block;
    }

    .download-btn {
      width: 100%;
      padding: 15px;
      background-color: var(--capra-ochre);
      color: var(--capra-black);
      border: none;
      border-radius: 4px;
      font-weight: 900;
      font-size: 1rem;
      text-transform: uppercase;
      cursor: pointer;
      margin-top: 10px;
      transition: background 0.2s;
    }
    .download-btn:hover { background-color: #d8c36b; }

    /* --- CANVAS PREVIEW --- */
    .canvas-wrapper {
      position: relative;
      transform-origin: top center;
      width: 540px;
      height: 540px;
    }

    #ig-canvas {
      width: 1080px;
      height: 1080px;
      background-color: var(--capra-black);
      position: absolute;
      top: 0;
      left: 0;
      transform: scale(0.5);
      transform-origin: top left;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* THEMES */
    #ig-canvas.theme-dark { background-color: var(--capra-black); color: var(--capra-white); }
    #ig-canvas.theme-light { background-color: var(--capra-offwhite); color: var(--capra-black); }
    #ig-canvas.theme-olive { background-color: var(--capra-olive); color: var(--capra-white); }

    .bg-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
      opacity: 0.4;
      mix-blend-mode: multiply;
      filter: grayscale(100%) contrast(1.1);
    }
    #ig-canvas.theme-light .bg-image { opacity: 0.1; mix-blend-mode: normal; }

    .overlay {
      position: absolute;
      inset: 0;
      z-index: 2;
    }
    #ig-canvas.theme-dark .overlay { background: linear-gradient(180deg, rgba(17,17,17,0.85) 0%, rgba(17,17,17,0.4) 50%, rgba(17,17,17,0.95) 100%); }
    #ig-canvas.theme-olive .overlay { background: linear-gradient(180deg, rgba(104,114,74,0.85) 0%, rgba(104,114,74,0.4) 50%, rgba(104,114,74,0.95) 100%); }

    /* COMMON LAYOUT */
    .content {
      position: relative;
      z-index: 10;
      padding: 70px 80px;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: auto;
    }
    .logo-area { display: flex; align-items: center; gap: 15px; }
    .logo-img { width: 55px; height: auto; }
    #ig-canvas.theme-light .logo-img { filter: invert(1); }
    .logo-text { font-family: "Michroma", sans-serif; font-size: 1.1rem; letter-spacing: 0.18em; line-height: 1.2; }
    .logo-text small { display: block; font-size: 0.55rem; color: var(--capra-ochre); letter-spacing: 0.3em; margin-top: 3px;}
    #ig-canvas.theme-light .logo-text small { color: var(--capra-olive); }
    #ig-canvas.theme-olive .logo-text small { color: var(--capra-offwhite); }

    .kicker {
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      text-align: right;
      color: var(--capra-ochre);
      border-right: 4px solid var(--capra-ochre);
      padding-right: 15px;
      white-space: pre-line;
    }
    #ig-canvas.theme-light .kicker { color: var(--capra-olive); border-color: var(--capra-olive); }
    #ig-canvas.theme-olive .kicker { color: var(--capra-white); border-color: var(--capra-white); }

    .slide-layout { display: none; flex: 1; flex-direction: column; justify-content: flex-end; }
    .slide-layout.active { display: flex; }

    /* COMMON TYPOGRAPHY */
    .highlight { color: var(--capra-ochre); }
    #ig-canvas.theme-light .highlight { color: var(--capra-olive); }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 15px;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 20px;
      color: var(--capra-ochre);
    }
    #ig-canvas.theme-light .eyebrow { color: var(--capra-olive); }
    .eyebrow::before { content: ""; width: 40px; height: 3px; background: currentColor; }


    /* --- SLIDE 1: HERO (Carousel) --- */
    .s1-headline { font-size: 5.5rem; font-weight: 900; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 30px; white-space: pre-line; }
    .s1-subhead { font-size: 1.8rem; font-weight: 400; line-height: 1.45; max-width: 800px; color: var(--capra-gray); white-space: pre-line; }
    #ig-canvas.theme-light .s1-subhead { color: #555; }

    /* --- SLIDE 2: INFO GRID (Carousel) --- */
    .s2-title { font-size: 3.5rem; font-weight: 900; letter-spacing: -0.03em; margin-bottom: 50px; }
    .s2-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px; }
    .s2-item { padding: 30px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-left: 5px solid var(--capra-ochre); }
    #ig-canvas.theme-light .s2-item { background: var(--capra-white); border-color: var(--capra-gray); border-left-color: var(--capra-olive); }
    #ig-canvas.theme-olive .s2-item { background: rgba(0,0,0,0.15); border-color: transparent; border-left-color: var(--capra-ochre); }
    .s2-item-label { display: block; font-size: 1.1rem; font-weight: 700; color: var(--capra-ochre); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; }
    #ig-canvas.theme-light .s2-item-label { color: var(--capra-olive); }
    #ig-canvas.theme-olive .s2-item-label { color: var(--capra-white); opacity: 0.8;}
    .s2-item-value { font-size: 2.2rem; font-weight: 900; line-height: 1.2; white-space: pre-line; }

    /* --- SLIDE 3: COACH (Carousel) --- */
    .s3-title { font-size: 3.5rem; font-weight: 900; letter-spacing: -0.03em; margin-bottom: 50px; }
    .s3-content { display: flex; gap: 40px; align-items: center; }
    .s3-image-ph { width: 350px; height: 450px; background: var(--capra-olive); display: flex; align-items: center; justify-content: center; font-size: 4rem; font-family: 'Michroma', sans-serif; color: var(--capra-ochre); overflow: hidden; position: relative; }
    .s3-image-ph img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%) contrast(1.1); }
    .s3-text { flex: 1; }
    .s3-name { font-size: 2.8rem; font-weight: 900; margin-bottom: 5px; letter-spacing: -0.02em;}
    .s3-role { font-size: 1.1rem; font-weight: 700; color: var(--capra-ochre); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 30px; }
    #ig-canvas.theme-light .s3-role { color: var(--capra-olive); }
    .s3-quote { font-size: 1.8rem; line-height: 1.5; font-weight: 400; border-left: 4px solid var(--capra-ochre); padding-left: 20px; white-space: pre-line;}
    #ig-canvas.theme-light .s3-quote { border-color: var(--capra-olive); }

    /* --- SLIDE 4: CTA (Carousel) --- */
    .s4-wrapper { text-align: center; margin: auto 0; }
    .s4-headline { font-size: 4.5rem; font-weight: 900; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 20px; }
    .s4-box { background: var(--capra-ochre); color: var(--capra-black); padding: 50px; display: inline-block; margin-top: 30px; }
    #ig-canvas.theme-light .s4-box { background: var(--capra-olive); color: var(--capra-white); }
    #ig-canvas.theme-olive .s4-box { background: var(--capra-black); color: var(--capra-white); }
    .s4-box-title { font-size: 1.4rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 20px; }
    .s4-email { font-size: 3rem; font-weight: 900; letter-spacing: -0.02em; display: block; margin-bottom: 10px; }
    .s4-url { font-size: 1.6rem; font-weight: 600; font-family: "Michroma", sans-serif; opacity: 0.8;}

    /* --- SLIDE 5: SINGLE 1 (All-in-one) --- */
    .s5-main-text { margin-bottom: 50px; }
    .s5-headline { font-size: 5rem; font-weight: 900; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 30px; white-space: pre-line; }
    .s5-subhead { font-size: 1.7rem; font-weight: 400; line-height: 1.45; max-width: 800px; color: var(--capra-gray); white-space: pre-line; }
    #ig-canvas.theme-light .s5-subhead { color: #555; }
    
    .s5-info-bar { display: flex; gap: 20px; margin-bottom: 20px; }
    .s5-info-item { flex: 1; background: var(--capra-olive); padding: 25px; border-top: 5px solid var(--capra-ochre); }
    #ig-canvas.theme-light .s5-info-item { background: var(--capra-white); border: 1px solid var(--capra-gray); border-top: 5px solid var(--capra-olive); }
    #ig-canvas.theme-olive .s5-info-item { background: var(--capra-black); }
    .s5-info-label { display: block; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--capra-offwhite); margin-bottom: 10px; opacity: 0.8; }
    #ig-canvas.theme-light .s5-info-label { color: var(--capra-olive); }
    .s5-info-value { font-size: 1.8rem; font-weight: 900; color: var(--capra-white); line-height: 1.2; white-space: pre-line;}
    #ig-canvas.theme-light .s5-info-value { color: var(--capra-black); }

    /* --- SLIDE 6: SINGLE 2 (Minimal) --- */
    .s6-wrapper { margin: auto 0; text-align: left; }
    .s6-quote { font-size: 5.5rem; font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; margin-bottom: 60px; white-space: pre-line;}
    .s6-cta { font-size: 1.8rem; font-weight: 700; border-left: 5px solid var(--capra-ochre); padding-left: 20px; white-space: pre-line; color: var(--capra-gray); line-height: 1.4;}
    #ig-canvas.theme-light .s6-cta { border-color: var(--capra-olive); color: var(--capra-black); }

  </style>
</head>
<body>

  <div class="app-container">
    
    <!-- CONTROLS -->
    <div class="controls">
      <h2>Mainosgeneraattori</h2>
      
      <!-- Theme Selection -->
      <div class="theme-select">
        <button id="btn-theme-dark" class="active" onclick="setTheme('dark')">Tumma</button>
        <button id="btn-theme-light" onclick="setTheme('light')">Vaalea</button>
        <button id="btn-theme-olive" onclick="setTheme('olive')">Oliivi</button>
      </div>

      <!-- Slide Tabs -->
      <div class="tabs">
        <!-- Karuselli -->
        <button id="tab-1" class="active" onclick="switchSlide(1)">C1: Otsikko</button>
        <button id="tab-2" onclick="switchSlide(2)">C2: Faktat</button>
        <button id="tab-3" onclick="switchSlide(3)">C3: Valmentaja</button>
        <button id="tab-4" onclick="switchSlide(4)">C4: Kutsusivu</button>
        <!-- Yksittäiset -->
        <button id="tab-5" onclick="switchSlide(5)">Yksittäinen 1</button>
        <button id="tab-6" onclick="switchSlide(6)">Yksittäinen 2</button>
      </div>

      <!-- Common Controls -->
      <div class="control-group">
        <label>Taustakuva (kaikkiin dioihin)</label>
        <input type="file" id="bg-upload" accept="image/*">
      </div>
      <div class="control-group">
        <label>Yläkulman tunniste (Kicker)</label>
        <input type="text" id="inp-kicker" value="JUNIORITOIMINTA\nSYKSY 2026" oninput="updateText('kicker')">
      </div>

      <!-- SLIDE 1 CONTROLS -->
      <div id="controls-1" class="slide-controls active">
        <div class="control-group">
          <label>Pieni yläotsikko (Eyebrow)</label>
          <input type="text" id="inp-s1-eyebrow" value="UUSI JUNIORIRYHMÄ" oninput="updateText('s1-eyebrow')">
        </div>
        <div class="control-group">
          <label>Pääotsikko (*sana* korostaa)</label>
          <textarea id="inp-s1-headline" oninput="updateHeadline('s1-headline')">Vahva alku.
*Hyvässä porukassa.*</textarea>
        </div>
        <div class="control-group">
          <label>Ingressi</label>
          <textarea id="inp-s1-subhead" oninput="updateText('s1-subhead')">Brasilialaista jujutsua ja lukkopainia 7-13 vuotiaille. Liikettä, oppimista ja onnistumisia turvallisessa harjoitusympäristössä.</textarea>
        </div>
      </div>

      <!-- SLIDE 2 CONTROLS -->
      <div id="controls-2" class="slide-controls">
        <div class="control-group">
          <label>Sivun Otsikko</label>
          <input type="text" id="inp-s2-title" value="Käytännön info." oninput="updateText('s2-title')">
        </div>
        <div style="display:flex; gap: 10px;">
          <div class="control-group" style="flex:1">
            <label>Laatikko 1 Otsikko</label>
            <input type="text" id="inp-s2-l1" value="HARJOITUSAJAT" oninput="updateText('s2-l1')">
            <label style="margin-top:5px;">Sisältö</label>
            <textarea id="inp-s2-v1" oninput="updateText('s2-v1')">To 16.30–17.45
La 11.00–12.00</textarea>
          </div>
          <div class="control-group" style="flex:1">
            <label>Laatikko 2 Otsikko</label>
            <input type="text" id="inp-s2-l2" value="IKÄRYHMÄ" oninput="updateText('s2-l2')">
            <label style="margin-top:5px;">Sisältö</label>
            <textarea id="inp-s2-v2" oninput="updateText('s2-v2')">7–13
vuotiaat</textarea>
          </div>
        </div>
        <div style="display:flex; gap: 10px;">
          <div class="control-group" style="flex:1">
            <label>Laatikko 3 Otsikko</label>
            <input type="text" id="inp-s2-l3" value="KAUSIMAKSU" oninput="updateText('s2-l3')">
            <label style="margin-top:5px;">Sisältö</label>
            <textarea id="inp-s2-v3" oninput="updateText('s2-v3')">99 €
/ kausi</textarea>
          </div>
          <div class="control-group" style="flex:1">
            <label>Laatikko 4 Otsikko</label>
            <input type="text" id="inp-s2-l4" value="KESTO" oninput="updateText('s2-l4')">
            <label style="margin-top:5px;">Sisältö</label>
            <textarea id="inp-s2-v4" oninput="updateText('s2-v4')">17.9. alkaen
joulukuun loppuun</textarea>
          </div>
        </div>
      </div>

      <!-- SLIDE 3 CONTROLS -->
      <div id="controls-3" class="slide-controls">
        <div class="control-group">
          <label>Sivun otsikko</label>
          <input type="text" id="inp-s3-title" value="Valmennus." oninput="updateText('s3-title')">
        </div>
        <div class="control-group">
          <label>Valmentajan kuva</label>
          <input type="file" id="coach-upload" accept="image/*">
        </div>
        <div class="control-group">
          <label>Nimi</label>
          <input type="text" id="inp-s3-name" value="Jere Hämäläinen" oninput="updateText('s3-name')">
        </div>
        <div class="control-group">
          <label>Rooli</label>
          <input type="text" id="inp-s3-role" value="JUNIOREIDEN PÄÄVALMENTAJA" oninput="updateText('s3-role')">
        </div>
        <div class="control-group">
          <label>Esittely / Lainaus</label>
          <textarea id="inp-s3-quote" oninput="updateText('s3-quote')">Laaja yli 10 vuoden kokemus lajista, kilpailemisesta ja valmentamisesta. 

Valmennuksessa korostuvat selkeys, turvallisuus ja jokaisen lapsen yksilöllinen kohtaaminen.</textarea>
        </div>
      </div>

      <!-- SLIDE 4 CONTROLS -->
      <div id="controls-4" class="slide-controls">
        <div class="control-group">
          <label>Pääotsikko</label>
          <textarea id="inp-s4-headline" oninput="updateText('s4-headline')">Tervetuloa mukaan
Capra Junioreihin.</textarea>
        </div>
        <div class="control-group">
          <label>CTA Laatikko - Yläteksti</label>
          <input type="text" id="inp-s4-title" value="ILMOITTAUTUMINEN JA LISÄTIEDOT" oninput="updateText('s4-title')">
        </div>
        <div class="control-group">
          <label>Sähköposti</label>
          <input type="text" id="inp-s4-email" value="info@capracombat.fi" oninput="updateText('s4-email')">
        </div>
        <div class="control-group">
          <label>Verkkosivu</label>
          <input type="text" id="inp-s4-url" value="www.capracombat.fi/juniorit" oninput="updateText('s4-url')">
        </div>
      </div>

      <!-- SLIDE 5 CONTROLS (Single 1) -->
      <div id="controls-5" class="slide-controls">
        <div class="control-group">
          <label>Pieni yläotsikko (Eyebrow)</label>
          <input type="text" id="inp-s5-eyebrow" value="BJJ & LUKKOPAINI" oninput="updateText('s5-eyebrow')">
        </div>
        <div class="control-group">
          <label>Pääotsikko (*sana* korostaa)</label>
          <textarea id="inp-s5-headline" oninput="updateHeadline('s5-headline')">Uusi junioriryhmä
alkaa *17.9.*</textarea>
        </div>
        <div class="control-group">
          <label>Ingressi</label>
          <textarea id="inp-s5-subhead" oninput="updateText('s5-subhead')">Ilmoittaudu mukaan: info@capracombat.fi
Lisätiedot: www.capracombat.fi/juniorit</textarea>
        </div>
        <div style="display:flex; gap: 10px; margin-top:15px; border-top:1px solid #444; padding-top:15px;">
          <div class="control-group" style="flex:1">
            <label>Info 1</label>
            <input type="text" id="inp-s5-l1" value="AJAT" oninput="updateText('s5-l1')">
            <textarea id="inp-s5-v1" oninput="updateText('s5-v1')" style="margin-top:5px; font-size:12px;">To 16.30
La 11.00</textarea>
          </div>
          <div class="control-group" style="flex:1">
            <label>Info 2</label>
            <input type="text" id="inp-s5-l2" value="IKÄRYHMÄ" oninput="updateText('s5-l2')">
            <textarea id="inp-s5-v2" oninput="updateText('s5-v2')" style="margin-top:5px; font-size:12px;">7–13
vuotiaat</textarea>
          </div>
          <div class="control-group" style="flex:1">
            <label>Info 3</label>
            <input type="text" id="inp-s5-l3" value="HINTA" oninput="updateText('s5-l3')">
            <textarea id="inp-s5-v3" oninput="updateText('s5-v3')" style="margin-top:5px; font-size:12px;">99 €
/ kausi</textarea>
          </div>
        </div>
      </div>

      <!-- SLIDE 6 CONTROLS (Single 2) -->
      <div id="controls-6" class="slide-controls">
        <div class="control-group">
          <label>Vahva lause (*sana* korostaa)</label>
          <textarea id="inp-s6-quote" oninput="updateHeadline('s6-quote')">Kasvualusta
*rohkeudelle.*</textarea>
        </div>
