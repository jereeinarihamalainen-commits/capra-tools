      <button class="download-btn" onclick="downloadImage()">Tallenna valittu dia</button>
    </div>

    <!-- CANVAS PREVIEW -->
    <div class="canvas-wrapper">
      <div id="ig-canvas" class="theme-dark">
        <img id="bg-img-element" class="bg-image" src="" style="display:none;" alt="">
        <div class="overlay"></div>

        <div class="content">
          <!-- Top Bar -->
          <div class="top-bar">
            <div class="logo-area">
              <img src="Capra Combat - vaalea (1).png" alt="Logo" class="logo-img needs-invert" onerror="this.style.display='none';">
              <div class="logo-text">CAPRA<small>COMBAT</small></div>
