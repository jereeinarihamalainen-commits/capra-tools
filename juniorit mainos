            <div class="kicker" id="txt-kicker">JUNIORITOIMINTA<br>SYKSY 2026</div>
          </div>

          <!-- SLIDE 1: HERO (Carousel) -->
          <div id="slide-1" class="slide-layout active">
            <div class="eyebrow" id="txt-s1-eyebrow">UUSI JUNIORIRYHMÄ</div>
            <div class="s1-headline" id="txt-s1-headline">Vahva alku.<br><span class="highlight">Hyvässä porukassa.</span></div>
            <div class="s1-subhead" id="txt-s1-subhead">Brasilialaista jujutsua ja lukkopainia 7-13 vuotiaille. Liikettä, oppimista ja onnistumisia turvallisessa harjoitusympäristössä.</div>
          </div>

          <!-- SLIDE 2: INFO (Carousel) -->
          <div id="slide-2" class="slide-layout">
            <div class="s2-title" id="txt-s2-title">Käytännön info.</div>
            <div class="s2-grid">
              <div class="s2-item">
                <span class="s2-item-label" id="txt-s2-l1">HARJOITUSAJAT</span>
                <span class="s2-item-value" id="txt-s2-v1">To 16.30–17.45<br>La 11.00–12.00</span>
              </div>
              <div class="s2-item">
                <span class="s2-item-label" id="txt-s2-l2">IKÄRYHMÄ</span>
                <span class="s2-item-value" id="txt-s2-v2">7–13<br>vuotiaat</span>
              </div>
              <div class="s2-item">
                <span class="s2-item-label" id="txt-s2-l3">KAUSIMAKSU</span>
                <span class="s2-item-value" id="txt-s2-v3">99 €<br>/ kausi</span>
              </div>
              <div class="s2-item">
                <span class="s2-item-label" id="txt-s2-l4">KESTO</span>
                <span class="s2-item-value" id="txt-s2-v4">17.9 alkaen<br>joulukuun loppuun</span>
              </div>
            </div>
          </div>

          <!-- SLIDE 3: COACH (Carousel) -->
          <div id="slide-3" class="slide-layout">
            <div class="s3-title" id="txt-s3-title">Valmennus.</div>
            <div class="s3-content">
              <div class="s3-image-ph">
                <img id="coach-img-element" src="" style="display:none;" alt="">
                <span id="coach-placeholder-icon">CC</span>
              </div>
              <div class="s3-text">
                <div class="s3-name" id="txt-s3-name">Jere Hämäläinen</div>
                <div class="s3-role" id="txt-s3-role">JUNIOREIDEN PÄÄVALMENTAJA</div>
                <div class="s3-quote" id="txt-s3-quote">Laaja yli 10 vuoden kokemus lajista, kilpailemisesta ja valmentamisesta.<br><br>Valmennuksessa korostuvat selkeys, turvallisuus ja jokaisen lapsen yksilöllinen kohtaaminen.</div>
              </div>
