          <!-- SLIDE 4: CTA (Carousel) -->
          <div id="slide-4" class="slide-layout">
            <div class="s4-wrapper">
              <div class="s4-headline" id="txt-s4-headline">Tervetuloa mukaan<br>Capra Junioreihin.</div>
              <div class="s4-box">
                <div class="s4-box-title" id="txt-s4-title">ILMOITTAUTUMINEN JA LISÄTIEDOT</div>
